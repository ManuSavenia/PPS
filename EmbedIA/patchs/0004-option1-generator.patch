@@ -193,6 +193,65 @@ def generate_embedia_model(model, src_folder, dst_folder, ext_h, ext_c, model_na
 
     embedia_layers = model.embedia_layers
 
+    # If FULL_QUANT8 and example data provided, run a quick calibration pass to compute
+    # per-layer output quantization params (scale_q, zero_point) so generated code
+    # initializes layer->output_qparam correctly.
+    if options.data_type == ModelDataType.FULL_QUANT8 and getattr(options, 'example_data', None) is not None:
+        try:
+            import numpy as _np
+            from embedia.core.type_converters import QuantizedTypeConverter
+            # Collect Keras layer outputs for layers that expose a Keras tensor
+            # (this includes dense layers and standalone Activation layers). This
+            # allows calibration to compute correct output qparams for
+            # post-activation values (important for nonlinear activations
+            # such as tanh/sigmoid/softmax).
+            keras_model = model.model
+            keras_targets = []
+            layer_map = []
+            for ly in embedia_layers:
+                target = getattr(ly, 'wrapper', None)
+                if target is None:
+                    continue
+                target_obj = getattr(target, '_target', None)
+                # Fallback: some wrappers may not expose _target; try locating
+                # the corresponding Keras layer by name in the keras model.
+                if target_obj is None:
+                    try:
+                        target_obj = keras_model.get_layer(getattr(target, 'name', None))
+                    except Exception:
+                        target_obj = None
+
+                if target_obj is not None and hasattr(target_obj, 'output'):
+                    # record which layer we're calibrating for diagnostics
+                    try:
+                        print(f"Calibrating output qparams for layer: {ly.name}")
+                    except Exception:
+                        pass
+                    keras_targets.append(target_obj.output)
+                    layer_map.append(ly)
+
+            if len(keras_targets) > 0:
+                from tensorflow.keras.models import Model as _KModel
+                calib_model = _KModel(inputs=keras_model.inputs, outputs=keras_targets)
+                # run on provided example_data (numpy array of floats)
+                example_X = options.example_data
+                if example_X is not None and len(example_X) > 0:
+                    preds = calib_model.predict(example_X, verbose=0)
+                    # preds can be a single array or list
+                    if not isinstance(preds, list):
+                        preds = [preds]
+                    for ly, out in zip(layer_map, preds):
+                        # flatten outputs and compute quant params
+                        qt = QuantizedTypeConverter(bits=8, symetric=True, signed=True)
+                        flat = _np.array(out).astype(_np.float32).flatten()
+                        qt.fit(flat)
+                        qp = qt.export_params(mode='q15')
+                        # store on embedia layer for later use in codegen
+                        setattr(ly, 'output_qp', qp)
+        except Exception:
+            # calibration is best-effort; don't fail generation on calibration errors
+            pass
+
